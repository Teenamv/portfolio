---
// Tia — a tiny scripted assistant that answers questions about Teena.
// No API keys, no backend: every answer is written here, on purpose.
---

<div class="tia" id="tia">
  <div class="tia__panel" id="tiaPanel" hidden>
    <div class="tia__head">
      <img class="tia__mark" src="/robot.svg" alt="" width="36" height="40" />
      <div class="tia__who">
        <strong>Tia</strong>
        <span>Teena's studio assistant</span>
      </div>
      <button class="tia__close" type="button" id="tiaClose" aria-label="Close chat">✕</button>
    </div>

    <div class="tia__log" id="tiaLog" role="log" aria-live="polite" aria-label="Conversation"></div>

    <div class="tia__chips" id="tiaChips"></div>

    <form class="tia__form" id="tiaForm" autocomplete="off">
      <label class="sr-only" for="tiaInput">Ask Tia a question</label>
      <input
        id="tiaInput"
        name="message"
        type="text"
        placeholder="Ask about skills, work, rates…"
        maxlength="220"
        required
      />
      <button type="submit" aria-label="Send">→</button>
    </form>
  </div>

  <button
    class="tia__launcher"
    type="button"
    id="tiaLauncher"
    aria-label="Ask Tia"
    aria-expanded="false"
    aria-controls="tiaPanel"
  >
    <img class="tia__bot" src="/robot.svg" alt="" width="160" height="180" />
  </button>
</div>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .tia {
    position: fixed;
    right: clamp(0.85rem, 2.4vw, 1.6rem);
    bottom: clamp(0.85rem, 2.4vw, 1.6rem);
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.7rem;
    font-family: var(--sans);
  }

  .tia__launcher {
    display: inline-flex;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    filter: drop-shadow(0 16px 24px rgba(6, 10, 22, 0.55));
  }

  .tia__bot {
    width: clamp(78px, 8vw, 104px);
    height: auto;
    transition: transform 0.3s cubic-bezier(0.22, 0.7, 0.3, 1);
  }

  .tia__launcher:hover .tia__bot,
  .tia__launcher:focus-visible .tia__bot {
    transform: translateY(-4px);
  }

  .tia[data-open='true'] .tia__bot {
    opacity: 0.75;
  }

  .tia__panel {
    width: min(370px, calc(100vw - 2rem));
    height: min(540px, calc(100vh - 7.5rem));
    display: flex;
    flex-direction: column;
    background: #131a2e;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 40px 70px -30px #000;
    animation: tia-in 0.28s cubic-bezier(0.22, 0.7, 0.3, 1);
  }

  .tia__panel[hidden] {
    display: none;
  }

  @keyframes tia-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.985);
    }
  }

  .tia__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 0.95rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: #101728;
    flex: none;
  }

  .tia__mark {
    width: 34px;
    height: auto;
    flex: none;
    padding: 2px;
    border-radius: 10px;
    background: rgba(124, 110, 250, 0.16);
  }

  .tia__who {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
  }

  .tia__who strong {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .tia__who span {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .tia__close {
    margin-left: auto;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: transparent;
    color: #fff;
    cursor: pointer;
    font-size: 0.7rem;
    line-height: 1;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .tia__close:hover {
    background: #fff;
    color: #0a0f1e;
  }

  .tia__log {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0.95rem 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    scrollbar-width: thin;
  }

  .tia__msg {
    max-width: 88%;
    padding: 0.62rem 0.85rem;
    border-radius: 14px;
    font-size: 0.9rem;
    line-height: 1.5;
    animation: tia-msg 0.24s ease both;
  }

  @keyframes tia-msg {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .tia__msg--bot {
    align-self: flex-start;
    background: #222a46;
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #e9ecf5;
    border-bottom-left-radius: 4px;
  }

  .tia__msg--user {
    align-self: flex-end;
    background: var(--violet);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .tia__msg a {
    color: #b9b1ff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tia__msg--user a {
    color: #fff;
  }

  .tia__typing {
    display: inline-flex;
    gap: 3px;
    align-items: center;
    padding: 0.85rem 0.9rem;
  }

  .tia__typing i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #8b93a8;
    animation: tia-dot 1.1s infinite ease-in-out;
  }

  .tia__typing i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .tia__typing i:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes tia-dot {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    30% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }

  .tia__chips {
    display: flex;
    gap: 0.35rem;
    padding: 0.5rem 0.95rem 0.55rem;
    overflow-x: auto;
    flex: none;
    scrollbar-width: none;
  }

  .tia__chips::-webkit-scrollbar {
    display: none;
  }

  .tia__chips button {
    flex: none;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.42rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .tia__chips button:hover {
    background: var(--violet);
    border-color: var(--violet);
    color: #fff;
  }

  .tia__form {
    display: flex;
    gap: 0.45rem;
    padding: 0.6rem 0.65rem 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex: none;
    background: #101728;
  }

  .tia__form input {
    flex: 1;
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 0.6rem 0.95rem;
    font-family: var(--sans);
    font-size: 0.88rem;
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
  }

  .tia__form input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .tia__form input:focus {
    outline: 2px solid var(--violet);
    outline-offset: 1px;
  }

  .tia__form button {
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 50%;
    border: 0;
    background: var(--violet);
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .tia__form button:hover {
    transform: scale(1.05);
    background: #8f83ff;
  }

  @media (max-width: 420px) {
    .tia__panel {
      width: calc(100vw - 1.5rem);
      height: min(520px, calc(100vh - 6.5rem));
    }

    .tia__bot {
      width: 76px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tia__panel,
    .tia__msg,
    .tia__typing i {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/tia-ui';
</script>
